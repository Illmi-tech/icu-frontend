generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             Int             @id @default(autoincrement())
  first_name     String
  last_name      String
  username       String          @unique
  password       String
  blogs          Blog[]
  careers        Career[]
  press_releases Press_release[]
  reports        Report[]
  scholarships   Scholarship[]
  volunteer_jobs Volunteer_Job[]

  @@map("admins")
}

model Blog {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  image_path String?
  image_id   String?
  slug       String   @unique
  date       DateTime @default(now())
  author_id  Int
  author     Admin    @relation(fields: [author_id], references: [id])

  @@index([author_id], map: "blogs_author_id_fkey")
  @@map("blogs")
}

model Career {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  image_path String?
  image_id   String?
  slug       String   @unique
  date       DateTime @default(now())
  admin_id   Int
  admin      Admin    @relation(fields: [admin_id], references: [id])

  @@index([admin_id], map: "careers_admin_id_fkey")
  @@map("careers")
}

model Volunteer_Job {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  image_path String?
  image_id   String?
  slug       String   @unique
  date       DateTime @default(now())
  admin_id   Int
  admin      Admin    @relation(fields: [admin_id], references: [id])

  @@index([admin_id], map: "volunteer_jobs_admin_id_fkey")
  @@map("volunteer_jobs")
}

model Scholarship {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  image_path String?
  image_id   String?
  slug       String   @unique
  date       DateTime @default(now())
  admin_id   Int
  admin      Admin    @relation(fields: [admin_id], references: [id])

  @@index([admin_id], map: "scholarships_admin_id_fkey")
  @@map("scholarships")
}

model Press_release {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  image_path String?
  image_id   String?
  slug       String   @unique
  date       DateTime @default(now())
  admin_id   Int
  admin      Admin    @relation(fields: [admin_id], references: [id])

  @@index([admin_id], map: "press_releases_admin_id_fkey")
  @@map("press_releases")
}

model Report {
  id         Int      @id @default(autoincrement())
  title      String
  image_path String?
  image_id   String?
  pdf_path   String
  pdf_id   String
  slug       String   @unique
  date       DateTime @default(now())
  admin_id   Int
  admin      Admin    @relation(fields: [admin_id], references: [id])

  @@index([admin_id], map: "reports_admin_id_fkey")
  @@map("reports")
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("subscribers")
}

