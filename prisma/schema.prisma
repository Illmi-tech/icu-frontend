generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             Int             @id @default(autoincrement())
  first_name     String
  last_name      String
  username       String          @unique
  password       String
  blogs          Blog[]
  careers        Career[]
  press_releases Press_release[]
  reports            Report[]
  newsletter_issues  NewsletterIssue[]
  scholarships       Scholarship[]
  volunteer_jobs Volunteer_Job[]

  @@map("admins")
}

model Blog {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  image_path String?
  image_id   String?
  slug       String   @unique
  date       DateTime @default(now())
  author_id  Int
  author     Admin    @relation(fields: [author_id], references: [id])

  @@map("blogs")
}

model Career {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  image_path String?
  image_id   String?
  slug       String   @unique
  date       DateTime @default(now())
  admin_id   Int
  admin      Admin    @relation(fields: [admin_id], references: [id])

  @@map("careers")
}

model Volunteer_Job {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  image_path String?
  image_id   String?
  slug       String   @unique
  date       DateTime @default(now())
  admin_id   Int
  admin      Admin    @relation(fields: [admin_id], references: [id])

  @@map("volunteer_jobs")
}

model Scholarship {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  image_path String?
  image_id   String?
  slug       String   @unique
  date       DateTime @default(now())
  admin_id   Int
  admin      Admin    @relation(fields: [admin_id], references: [id])

  @@map("scholarships")
}

model Press_release {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  image_path String?
  image_id   String?
  slug       String   @unique
  date       DateTime @default(now())
  admin_id   Int
  admin      Admin    @relation(fields: [admin_id], references: [id])

  @@map("press_releases")
}

model Report {
  id         Int      @id @default(autoincrement())
  title      String
  image_path String?
  image_id   String?
  pdf_path   String
  pdf_id   String
  slug       String   @unique
  date       DateTime @default(now())
  admin_id   Int
  admin      Admin    @relation(fields: [admin_id], references: [id])

  @@map("reports")
}

model NewsletterIssue {
  id         Int      @id @default(autoincrement())
  title      String
  image_path String?
  image_id   String?
  pdf_path   String
  pdf_id     String
  slug       String   @unique
  date       DateTime @default(now())
  admin_id   Int
  admin      Admin    @relation(fields: [admin_id], references: [id])

  @@map("newsletter_issues")
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model Seat {
  id        Int      @id @default(autoincrement())
  row       Int
  column    Int
  full_name String
  paid_at   DateTime @default(now())

  @@unique([row, column])
  @@map("seats")
}

model Sponsor {
  id                Int      @id @default(autoincrement())
  category          String
  amount            Int
  full_name         String
  email             String?
  phone             String?
  organization_name String?
  celebration       String?
  school_days       Int?
  seats_count       Int?
  is_read           Boolean  @default(false)
  created_at        DateTime @default(now())

  @@index([created_at])
  @@index([is_read])
  @@index([category])
  @@map("sponsors")
}

